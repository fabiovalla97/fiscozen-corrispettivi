# Copy to .env and fill in the values:
#   cp .env.example .env

# Google Sheet ID (from the spreadsheet URL) and tab name
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB=incassi

# OAuth client JSON (Google Cloud → Credentials → OAuth client)
GOOGLE_OAUTH_CLIENT_PATH=.secrets/google-oauth-web.json
# Token file created by: npm run google-auth
GOOGLE_OAUTH_TOKEN_PATH=.secrets/google-sheets-oauth-token.json
# Optional instead of OAuth: service account JSON + share the sheet with client_email
# GOOGLE_SERVICE_ACCOUNT_PATH=.secrets/google-service-account.json

FISCOZEN_BASE_URL=https://app.fiscozen.it
FISCOZEN_BROWSER_PROFILE_DIR=./data/browser-profile

TIMEZONE=Europe/Rome

# Safety: set to true only when you want the script to click Salva
FISCOZEN_AUTO_SUBMIT=false

# Optional filters (ISO dates, inclusive) on giorno (created_at)
# CORRISPETTIVI_FROM=2026-02-01
# CORRISPETTIVI_TO=2026-02-28

# Optional: force Fiscozen month (otherwise from created_at of first pending row)
# CORRISPETTIVI_MONTH=2026-07
